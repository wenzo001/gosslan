{
  "name": "gosslan",
  "private": true,
  "version": "5.15.35",
  "type": "module",
  "description": "Gosslan — 无服务器 P2P 局域网即时通讯（Tauri v2 + Vue 3 + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/frontend-build.mjs",
    "dist": "node scripts/package.mjs",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --full-gate",
    "verify:local": "node scripts/verify.mjs --full-gate --skip-guard-sweep",
    "lint:py": "uvx ruff@0.17.1 check scripts",
    "lint:sh": "uvx --from shellcheck-py shellcheck -S warning --exclude=SC2034 $(git ls-files '*.sh')",
    "lint:md": "npx --yes markdownlint-cli2@0.18.1",
    "lint": "npm run lint:py && npm run lint:sh && npm run lint:md",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning \"src/**/*.test.ts\" \"scripts/*.test.ts\"",
    "test:ui-runtime": "node scripts/check-ui-runtime.mjs",
    "tauri": "tauri",
    "icon": "tauri icon src-tauri/icons/icon.png",
    "version:show": "node scripts/version.mjs show",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "dist:win": "tauri build --features bluetooth --bundles nsis --target x86_64-pc-windows-msvc",
    "dist:mac": "tauri build --features bluetooth --target aarch64-apple-darwin",
    "dist:mac:intel": "tauri build --features bluetooth --target x86_64-apple-darwin",
    "dist:win:arm64": "tauri build --features bluetooth --bundles nsis --target aarch64-pc-windows-msvc",
    "dist:win:msi": "tauri build --features bluetooth --bundles nsis,msi",
    "dist:win:test": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-release.ps1",
    "dist:win:portable": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-portable.ps1",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "node scripts/inject-android-signing.mjs && tauri android build --apk",
    "android:build:debug": "tauri android build --debug --apk",
    "android:build:release": "bash scripts/build-android-releases.sh",
    "env:check": "powershell -ExecutionPolicy Bypass -File scripts/check-env.ps1",
    "env:install": "powershell -ExecutionPolicy Bypass -File scripts/install-env.ps1",
    "multi:run": "powershell -ExecutionPolicy Bypass -File scripts/run-multi-instance.ps1",
    "android:build:test": "bash scripts/build-android-releases.sh --debug",
    "version:check": "node scripts/semver.mjs check",
    "version:changelog": "node scripts/semver.mjs changelog",
    "version:audit-attribution": "node scripts/semver.mjs audit-attribution",
    "version:classify": "node scripts/semver.mjs classify",
    "version:ledger": "node scripts/semver.mjs ledger",
    "version:release": "node scripts/semver.mjs release",
    "dist:mac:app": "tauri build --features bluetooth --bundles app --target aarch64-apple-darwin && bash scripts/pack-macos-app.sh",
    "verify:e2e": "node scripts/verify.mjs --group local",
    "verify:ax": "node scripts/check-ui-runtime-ax.mjs",
    "verify:release": "node scripts/verify.mjs --group release",
    "verify:all": "npm run verify:full && npm run verify:e2e",
    "test:e2e:multi-instance": "node scripts/e2e-multi-instance.mjs",
    "test:e2e:negative": "node scripts/e2e-multi-instance.mjs --negative",
    "test:fault-injection": "node scripts/e2e-multi-instance.mjs --fault=poison-part",
    "test:e2e:group": "node scripts/e2e-multi-instance.mjs --round=group",
    "test:e2e:group-selfproof": "node scripts/e2e-multi-instance.mjs --round=group-lie",
    "test:e2e:groupcrash": "node scripts/e2e-multi-instance.mjs --round=groupcrash",
    "test:e2e:groupcrash-selfproof": "node scripts/e2e-multi-instance.mjs --round=groupcrash-lie",
    "test:e2e:gfile": "node scripts/e2e-multi-instance.mjs --round=gfile",
    "test:e2e:gfile-selfproof": "node scripts/e2e-multi-instance.mjs --round=gfile-lie",
    "test:e2e:dmreaction": "node scripts/e2e-multi-instance.mjs --round=dmreaction",
    "test:e2e:dmreaction-selfproof": "node scripts/e2e-multi-instance.mjs --round=dmreaction-lie",
    "test:e2e:posttext": "node scripts/e2e-multi-instance.mjs --round=posttext",
    "test:e2e:posttext-selfproof": "node scripts/e2e-multi-instance.mjs --round=posttext-lie",
    "test:e2e:contentpull": "node scripts/e2e-multi-instance.mjs --round=contentpull",
    "test:e2e:contentpull-selfproof": "node scripts/e2e-multi-instance.mjs --round=contentpull-lie",
    "test:e2e:logtail-selfproof": "node scripts/e2e-multi-instance.mjs --logtail-selfcheck",
    "test:fault-injection:resume": "node scripts/e2e-multi-instance.mjs --fault=resume-prefix",
    "test:fault-injection:kill": "node scripts/e2e-multi-instance.mjs --fault=kill-mid",
    "test:fault-injection:kill-selfproof": "node scripts/e2e-multi-instance.mjs --fault=kill-mid-lie",
    "test:fault-injection:freeze": "node scripts/e2e-multi-instance.mjs --fault=peer-freeze",
    "test:fault-injection:freeze-selfproof": "node scripts/e2e-multi-instance.mjs --fault=peer-freeze-lie",
    "test:fault-injection:disk": "node scripts/e2e-multi-instance.mjs --fault=recv-readonly",
    "test:fault-injection:rename": "node scripts/e2e-multi-instance.mjs --fault=recv-dir-rotted",
    "test:fault-injection:rename-selfproof": "node scripts/e2e-multi-instance.mjs --fault=recv-dir-rotted-lie",
    "test:fault-injection:shrink": "node scripts/e2e-multi-instance.mjs --fault=src-shrunk",
    "test:fault-injection:shrink-selfproof": "node scripts/e2e-multi-instance.mjs --fault=src-shrunk-lie",
    "test:fault-injection:multi": "node scripts/e2e-multi-instance.mjs --fault=multi-file",
    "test:fault-injection:multi-selfproof": "node scripts/e2e-multi-instance.mjs --fault=multi-file-lie",
    "test:fault-injection:stall": "node scripts/e2e-multi-instance.mjs --fault=stall-mid",
    "test:fault-injection:stall-selfproof": "node scripts/e2e-multi-instance.mjs --fault=stall-mid-lie",
    "test:fault-injection:sendside": "node scripts/e2e-multi-instance.mjs --fault=sender-kill-mid",
    "test:fault-injection:sendside-selfproof": "node scripts/e2e-multi-instance.mjs --fault=sender-kill-mid-lie",
    "test:fault-injection:disk-selfproof": "node scripts/e2e-multi-instance.mjs --fault=recv-readonly-lie",
    "test:fault-injection:resume-selfproof": "node scripts/e2e-multi-instance.mjs --fault=resume-prefix-lie",
    "test:fault-injection:selfproof": "node scripts/e2e-multi-instance.mjs --fault=poison-part-lie",
    "test:e2e:shot-selfproof": "node scripts/e2e-multi-instance.mjs --shot-selfcheck",
    "test:e2e:report-contract-selfproof": "node scripts/e2e-multi-instance.mjs --report-contract-selfcheck",
    "test:e2e:group-targets-selfproof": "node scripts/e2e-multi-instance.mjs --round=group-targets-lie",
    "test:e2e:gossip3-selfproof": "node scripts/e2e-multi-instance.mjs --round=gossip3-lie",
    "test:e2e:gossip-late-selfproof": "node scripts/e2e-multi-instance.mjs --round=gossip-late-lie",
    "test:e2e:ghsync": "node scripts/e2e-multi-instance.mjs --round=ghsync",
    "test:e2e:ghsync-selfproof": "node scripts/e2e-multi-instance.mjs --round=ghsync-lie",
    "test:e2e:lanoff-selfproof": "node scripts/e2e-multi-instance.mjs --round=lanoff-lie",
    "test:e2e:task-selfproof": "node scripts/e2e-multi-instance.mjs --round=task-lie",
    "selfproof:check": "node scripts/check-selfproof-baseline.mjs",
    "selfproof:sync": "node scripts/check-selfproof-baseline.mjs --sync",
    "ci:status": "node scripts/ci-status.mjs",
    "map:stats": "node scripts/arch-map-stats.mjs",
    "coverage:features": "node scripts/feature-coverage.mjs"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.4",
    "@tanstack/vue-virtual": "^3.13.47",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "@vueuse/core": "^14.4.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.10.0",
    "lucide-vue-next": "^0.469.0",
    "marked": "^18.1.2",
    "mitt": "3.0.1",
    "motion-v": "2.8.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.13",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vue-tsc": "^2.1.10"
  }
}
