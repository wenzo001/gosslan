  "tokens": {
    "source": "design-system-pulse/project/tokens.json",
    "code": "src/style.css",
    "tailwind": "tailwind.config.js",
    "themeBoot": "src/boot/theme-boot.js",
    "appearance": "src/utils/appearance.ts",
    "notes": "Use CSS variables/tokens; do not hardcode hex in components. Current code primary is #3b82f6; design primary is #2f6bff."
  },
  "rules": [
    "No new features, no Rust/protocol/DB changes for a UI-only task.",
    "Do not copy artboard DOM/CSS; implement with existing Vue components and tokens.",
    "One icon set across desktop, mobile and auxiliary windows; only sizes change.",
    "One status signal only: if avatar has presence dot, meta must not repeat a dot or 在线/离线 text.",
    "Long text: single-line ellipsis with min-width:0, two-line clamp for snippets/reasons, overflow-wrap:anywhere for URLs, mono word-break for technical strings.",
    "i18n: every new UI string in zh-cn and en-us, referenced through t().",
    "Motion: appear-once, no replay on state change, reduce motion uses fade only.",
    "If uncertain about product behavior, ask; do not invent."
  ],
  "screens": [
    {
      "id": "desktop-chats",
      "route": "/chats",
      "artboards": ["design-canvas-pulse/project/DesktopChats.dc.html", "design-canvas-pulse/project/DesktopEdgeCases.dc.html"],
