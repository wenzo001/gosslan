  "verification": {
    "commands": ["npm test", "npm run test:ui-runtime", "npm run verify:full"],
    "designChecks": [
      "no horizontal overflow at 1000x680, 780x600, 760x560, 780x620, 1120x820, 390x844",
      "long names, long URL, long filename, IPv6 and security code handled",
      "one presence signal only; no duplicate online dot/text",
      "same icon paths on desktop/mobile/aux windows",
      "zh-cn and en-us both pass",
      "dark, reduced motion, keyboard focus, 44px hit targets"
    ]
  },
  "phases": [
    "tokens + skeleton (52 header, 320 list, 62/64 rows)",
    "icon registry + app icon bundle",
    "desktop main shell/list/chat",
    "mobile tabs/list/chat",
    "aux windows and dense screens",
    "states, edge cases, i18n and verification"
  ]
