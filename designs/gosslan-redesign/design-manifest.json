    { "label": "settings", "size": "780x600", "min": "560x420", "config": "src-tauri/src/commands/logs.rs" },
    { "label": "logs", "size": "760x560", "min": "420x320", "config": "src-tauri/src/commands/logs.rs" },
    { "label": "tasks", "size": "780x620", "min": "360x420", "config": "src-tauri/src/commands/logs.rs" },
    { "label": "preview", "size": "1120x820", "min": "480x360", "config": "src-tauri/src/commands/logs.rs" },
