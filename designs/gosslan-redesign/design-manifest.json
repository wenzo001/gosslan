{
  "name": "Gosslan Pulse",
  "version": "2.2",
  "updated": "2026-11-06",
  "designRoot": "designs/gosslan-redesign",
  "status": "design delivered, awaiting implementation review",
  "entryPoint": "designs/gosslan-redesign/HANDOFF.md",
  "readOrder": [
    "HANDOFF.md",
    "design-system-pulse/project/tokens.json",
    "design-system-pulse/project/README.md",
    "docs/decisions.md",
    "docs/edge-cases.md",
    "docs/feature-coverage.md",
    "docs/verification-v2.md"
