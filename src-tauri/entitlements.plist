<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Bluetooth LE：App Sandbox 下**没有这条权限，CoreBluetooth 连扫描都做不了**
	     （CBManager 的 state 会一直停在 Unauthorized，现象是"打开了蓝牙开关却一个设备也发现不了"）。
	     central（扫描/连接）与 peripheral（广播/被连接）两条路都靠它。 -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- 共享目录要**跨重启**保住访问权，必须能创建 security-scoped bookmark；
	     沙盒里缺这条 app-scope 权限时 `NSURLBookmarkCreationWithSecurityScope` 会被拒，
	     而"只存路径"在重启后就失效 —— 现象是共享目录列表变空且没有任何报错。
	     （document-scope 是给"文档类 App 把书签存进文件"用的，本应用不需要。） -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- iOS Universal Links 关联域骨架。值 applinks:<占位域名> 必须与 AndroidManifest.xml
	     的 android:host、站点关联文件模板里的域名三处一致。
	     为什么放这里：iOS 只认签名包里 entitlements 的
	     com.apple.developer.associated-domains 来决定是否允许接管该域的 HTTPS 链接；
	     缺这条时即使 Info.plist 声明了 URL scheme，系统也不会把网页链接交给应用。
	     link.example.invalid 用 RFC 2606 保留的 .invalid 顶级域，故意不可解析，
	     不编造真实域名。真实域名、带 Associated Domains capability 的
	     provisioning profile、站点文件部署与真机唤起验证完成前，这一格标 NOT RUN。
	     站点关联文件模板见 docs/link-handoff/apple-app-site-association.example。 -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:link.example.invalid</string>
	</array>
</dict>
</plist>
