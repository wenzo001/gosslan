{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gosslan",
  "version": "5.15.10",
  "identifier": "com.gosslan.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwQTNEMTlFRTk5Mjg2MkYKUldRdmhwTHBudEdqNExoRXEra1dCSkVXMFZ2cjVtM0tiUzB6ZC9idEtPVXJPbWhDd3hSbzVzdlcK",
      "endpoints": [
        "https://github.com/wenzo001/gosslan/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gosslan",
        "width": 1000,
        "height": 680,
        "minWidth": 360,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#edf1f6",
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; worker-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "无服务器 P2P 局域网即时通讯",
    "longDescription": "Gosslan 是一款无中央服务器的 P2P 局域网即时通讯工具，支持设备发现、好友、群聊、文件传输与共享目录。",
    "resources": [
      "PrivacyInfo.xcprivacy"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "infoplist/en.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "infoplist/zh-Hans.lproj/InfoPlist.strings"
      }
    },
    "iOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
